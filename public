<div class="modal" id="winnerModal">
  <div class="modal-content">
    <h2>🏆 سەرکەوتن! 🏆</h2>
    <p id="winnerText"></p>
    <button class="btn btn-primary" id="restartBtn" style="display:none;">🔄 یاریەکی نوێ</button>
    <button class="btn btn-secondary" id="leaveBtn">🚪 دەرچوون</button>
