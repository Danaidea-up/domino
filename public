<!DOCTYPE html>

<html lang="ckb" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎲 یاری دۆمینۆی ئۆنڵاین</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800&display=swap');

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
font-family: ‘Vazirmatn’, sans-serif;
background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
background-attachment: fixed;
min-height: 100vh;
padding: 20px;
color: #fff;
}

body::before {
content: ‘’;
position: fixed;
inset: 0;
background-image:
radial-gradient(circle at 20% 30%, rgba(255,200,100,0.2) 0%, transparent 40%),
radial-gradient(circle at 80% 70%, rgba(100,255,200,0.2) 0%, transparent 40%);
pointer-events: none;
z-index: 0;
}

.container {
max-width: 1200px;
margin: 0 auto;
position: relative;
z-index: 1;
}

h1 {
text-align: center;
font-size: clamp(2rem, 5vw, 3.5rem);
font-weight: 800;
margin-bottom: 10px;
background: linear-gradient(45deg, #ffeaa7, #fab1a0, #fd79a8);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
}

.subtitle {
text-align: center;
margin-bottom: 30px;
opacity: 0.9;
}

/* Screens */
.screen { display: none; }
.screen.active { display: block; }

/* Card */
.card {
background: rgba(255,255,255,0.15);
backdrop-filter: blur(20px);
border: 2px solid rgba(255,255,255,0.3);
border-radius: 25px;
padding: 35px;
max-width: 500px;
margin: 0 auto;
box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

.card h2 { text-align: center; margin-bottom: 20px; font-size: 1.6rem; }

input[type=“text”] {
width: 100%;
padding: 14px 18px;
border-radius: 15px;
border: 2px solid rgba(255,255,255,0.4);
background: rgba(255,255,255,0.2);
color: #fff;
font-size: 1rem;
font-family: inherit;
margin-bottom: 15px;
text-align: center;
}

input[type=“text”]::placeholder { color: rgba(255,255,255,0.6); }
input[type=“text”]:focus {
outline: none;
border-color: #ffeaa7;
background: rgba(255,255,255,0.3);
}

.btn {
width: 100%;
padding: 14px;
border-radius: 15px;
border: none;
color: #fff;
font-size: 1.1rem;
font-weight: 700;
cursor: pointer;
font-family: inherit;
margin-bottom: 10px;
transition: all 0.3s;
}

.btn:hover:not(:disabled) { transform: translateY(-3px); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-primary { background: linear-gradient(45deg, #00b894, #00cec9); box-shadow: 0 8px 20px rgba(0,184,148,0.4); }
.btn-secondary { background: linear-gradient(45deg, #fd79a8, #e84393); box-shadow: 0 8px 20px rgba(253,121,168,0.4); }
.btn-warning { background: linear-gradient(45deg, #fdcb6e, #e17055); }
.btn-info { background: linear-gradient(45deg, #74b9ff, #0984e3); }
.btn-purple { background: linear-gradient(45deg, #a29bfe, #6c5ce7); }

.divider {
text-align: center;
margin: 20px 0;
opacity: 0.7;
position: relative;
}
.divider::before, .divider::after {
content: ‘’;
position: absolute;
top: 50%;
width: 40%;
height: 1px;
background: rgba(255,255,255,0.3);
}
.divider::before { right: 0; }
.divider::after { left: 0; }

/* Lobby */
.room-code {
background: linear-gradient(45deg, #fdcb6e, #e17055);
padding: 15px;
border-radius: 15px;
text-align: center;
margin-bottom: 20px;
font-size: 1.5rem;
font-weight: 800;
letter-spacing: 3px;
box-shadow: 0 8px 20px rgba(253,203,110,0.4);
cursor: pointer;
}
.room-code small { display: block; font-size: 0.8rem; font-weight: 400; margin-bottom: 5px; opacity: 0.9; }

.players-list { margin-bottom: 20px; }
.player-item {
background: rgba(255,255,255,0.1);
border-radius: 12px;
padding: 12px 15px;
margin-bottom: 8px;
display: flex;
justify-content: space-between;
align-items: center;
}
.host-badge { background: #fdcb6e; color: #2d3436; padding: 3px 10px; border-radius: 10px; font-size: 0.8rem; font-weight: 700; }

/* Game */
.players-bar {
display: flex;
gap: 12px;
justify-content: center;
margin-bottom: 20px;
flex-wrap: wrap;
}
.player-card {
background: rgba(255,255,255,0.15);
backdrop-filter: blur(10px);
border: 2px solid rgba(255,255,255,0.3);
border-radius: 18px;
padding: 10px 18px;
text-align: center;
transition: all 0.3s;
min-width: 130px;
}
.player-card.current {
background: linear-gradient(45deg, #fdcb6e, #e17055);
border-color: #fff;
transform: scale(1.05);
box-shadow: 0 10px 25px rgba(253,203,110,0.5);
}
.player-card.disconnected { opacity: 0.5; }
.player-card .name { font-weight: 700; }
.player-card .info { font-size: 0.85rem; opacity: 0.9; margin-top: 3px; }

.board-container {
background: rgba(0,0,0,0.25);
backdrop-filter: blur(15px);
border: 2px solid rgba(255,255,255,0.2);
border-radius: 25px;
padding: 25px 15px;
margin-bottom: 20px;
min-height: 150px;
overflow-x: auto;
box-shadow: inset 0 4px 20px rgba(0,0,0,0.3);
}
.board {
display: flex;
align-items: center;
justify-content: center;
gap: 2px;
flex-wrap: wrap;
min-height: 80px;
}
.board.empty::before {
content: ‘🎲 چاوەڕێی یەکەم دۆمینۆ…’;
color: rgba(255,255,255,0.5);
font-size: 1.1rem;
}

/* Domino */
.domino {
background: linear-gradient(145deg, #fff, #f0f0f0);
border: 2px solid #2d3436;
border-radius: 8px;
box-shadow: 0 4px 8px rgba(0,0,0,0.3);
overflow: hidden;
display: inline-flex;
}
.domino.horizontal { width: 70px; height: 35px; flex-direction: row; }
.domino.vertical { width: 35px; height: 70px; flex-direction: column; }
.domino-half {
flex: 1;
display: grid;
grid-template-columns: repeat(3, 1fr);
grid-template-rows: repeat(3, 1fr);
gap: 1px;
padding: 3px;
}
.domino.horizontal .domino-half:first-child { border-left: 2px solid #2d3436; }
.domino.vertical .domino-half:first-child { border-bottom: 2px solid #2d3436; }
.pip { width: 5px; height: 5px; border-radius: 50%; background: #2d3436; align-self: center; justify-self: center; }

/* Hand */
.hand-container {
background: rgba(255,255,255,0.1);
backdrop-filter: blur(15px);
border-radius: 20px;
padding: 18px;
margin-bottom: 18px;
}
.hand-title { text-align: center; margin-bottom: 12px; font-weight: 600; }
.hand { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }

.hand-tile {
background: linear-gradient(145deg, #fff, #f0f0f0);
border: 2px solid #2d3436;
border-radius: 8px;
width: 55px;
height: 95px;
display: flex;
flex-direction: column;
cursor: pointer;
transition: all 0.3s;
box-shadow: 0 4px 8px rgba(0,0,0,0.3);
}
.hand-tile:hover { transform: translateY(-8px); }
.hand-tile.selected {
transform: translateY(-15px);
border-color: #fd79a8;
border-width: 3px;
box-shadow: 0 15px 25px rgba(253,121,168,0.6);
}
.hand-tile.playable { border-color: #00b894; animation: pulse 2s infinite; }
.hand-tile.disabled { opacity: 0.5; cursor: not-allowed; }
@keyframes pulse {
0%, 100% { box-shadow: 0 4px 8px rgba(0,0,0,0.3); }
50% { box-shadow: 0 4px 20px rgba(0,184,148,0.6); }
}
.hand-tile .domino-half { flex: 1; }
.hand-tile .domino-half:first-child { border-bottom: 2px solid #2d3436; }

/* Controls */
.controls {
display: flex;
gap: 10px;
justify-content: center;
flex-wrap: wrap;
}
.control-btn {
padding: 12px 22px;
border-radius: 14px;
border: none;
color: #fff;
font-size: 0.95rem;
font-weight: 600;
cursor: pointer;
font-family: inherit;
transition: all 0.3s;
}
.control-btn:hover:not(:disabled) { transform: translateY(-2px); }
.control-btn:disabled { opacity: 0.4; cursor: not-allowed; }

/* Message */
.message {
background: rgba(0,0,0,0.3);
border-radius: 15px;
padding: 12px;
text-align: center;
margin-bottom: 18px;
font-weight: 600;
}
.message.error { background: rgba(214,48,49,0.6); }

.boneyard-info { text-align: center; margin-top: 10px; opacity: 0.8; font-size: 0.9rem; }

/* Modal */
.modal {
display: none;
position: fixed;
inset: 0;
background: rgba(0,0,0,0.85);
z-index: 100;
align-items: center;
justify-content: center;
padding: 20px;
}
.modal.active { display: flex; }
.modal-content {
background: linear-gradient(135deg, #fdcb6e, #e17055, #d63031);
border-radius: 25px;
padding: 35px;
text-align: center;
max-width: 450px;
box-shadow: 0 30px 80px rgba(0,0,0,0.5);
animation: bounceIn 0.6s;
}
@keyframes bounceIn {
0% { transform: scale(0.3); opacity: 0; }
50% { transform: scale(1.05); }
100% { transform: scale(1); opacity: 1; }
}
.modal h2 { font-size: 2.2rem; margin-bottom: 12px; }
.modal p { font-size: 1.15rem; margin-bottom: 20px; }

.copied-toast {
position: fixed;
bottom: 30px;
left: 50%;
transform: translateX(-50%);
background: #00b894;
padding: 12px 25px;
border-radius: 30px;
font-weight: 600;
box-shadow: 0 10px 25px rgba(0,184,148,0.5);
opacity: 0;
pointer-events: none;
transition: opacity 0.3s;
}
.copied-toast.show { opacity: 1; }

@media (max-width: 600px) {
.card { padding: 25px 20px; }
.hand-tile { width: 48px; height: 82px; }
.domino.horizontal { width: 60px; height: 30px; }
.domino.vertical { width: 30px; height: 60px; }
}
</style>

</head>
