<div class="copied-toast" id="copiedToast">✅ کۆپی کرا!</div>

<script src="/socket.io/socket.io.js"></script>

<script>
const socket = io();
let myPlayerId = null;
let currentRoomId = null;
let isHost = false;
let selectedTile = null;
let gameData = null;

// ========== DOM Helpers ==========
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function showMessage(msg, isError = false) {
  const el = document.getElementById('message');
  el.textContent = msg;
  el.className = 'message' + (isError ? ' error' : '');
  if (isError) setTimeout(() => el.className = 'message', 3000);
}

function showToast(msg) {
  const toast = document.getElementById('copiedToast');
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2000);
}

// ========== Domino Pip Rendering ==========
function createPips(value) {
  const positions = {
    0: [], 1: [5], 2: [1, 9], 3: [1, 5, 9],
    4: [1, 3, 7, 9], 5: [1, 3, 5, 7, 9], 6: [1, 3, 4, 6, 7, 9]
  };
  const pips = positions[value] || [];
  let html = '';
  for (let i = 1; i <= 9; i++) {
    html += `<div class="pip" style="${pips.includes(i) ? '' : 'visibility:hidden'}"></div>`;
  }
  return html;
}

function getBoardEnds(board) {
  if (board.length === 0) return { left: null, right: null };
  return { left: board[0].left, right: board[board.length - 1].right };
}

function canPlayTile(tile, board) {
  if (board.length === 0) return { left: true, right: true };
  const ends = getBoardEnds(board);
  return {
    left: tile.left === ends.left || tile.right === ends.left,
    right: tile.left === ends.right || tile.right === ends.right
  };
}

// ========== Home Screen ==========
document.getElementById('createRoomBtn').addEventListener('click', () => {
  const name = document.getElementById('playerNameInput').value.trim();
  if (!name) { alert('تکایە ناوەکەت بنووسە!'); return; }
  socket.emit('createRoom', { playerName: name });
});

document.getElementById('joinRoomBtn').addEventListener('click', () => {
  const name = document.getElementById('playerNameInput').value.trim();
  const code = document.getElementById('roomCodeInput').value.trim().toUpperCase();
  if (!name) { alert('تکایە ناوەکەت بنووسە!'); return; }
  if (!code || code.length !== 4) { alert('تکایە کۆدی دروستی ٤ پیتی بنووسە!'); return; }
  socket.emit('joinRoom', { roomId: code, playerName: name });
});

// ========== Lobby ==========
document.getElementById('roomCodeDisplay').addEventListener('click', () => {
  if (currentRoomId) {
    navigator.clipboard.writeText(currentRoomId).then(() => showToast('✅ کۆد کۆپی کرا!'));
  }
});

document.getElementById('startGameBtn').addEventListener('click', () => {
  socket.emit('startGame');
});

// ========== Game Controls ==========
document.getElementById('playLeftBtn').addEventListener('click', () => {
  if (!selectedTile) return;
  socket.emit('playTile', { tileId: selectedTile.id, side: 'left' });
});

document.getElementById('playRightBtn').addEventListener('click', () => {
  if (!selectedTile) return;
  const side = (gameData && gameData.board.length === 0) ? 'right' : 'right';
  socket.emit('playTile', { tileId: selectedTile.id, side });
});

document.getElementById('drawBtn').addEventListener('click', () => {
  socket.emit('drawTile');
});

document.getElementById('passBtn').addEventListener('click', () => {
  socket.emit('passTurn');
});

document.getElementById('restartBtn').addEventListener('click', () => {
  document.getElementById('winnerModal').classList.remove('active');
  socket.emit('restartGame');
});

document.getElementById('leaveBtn').addEventListener('click', () => {
  location.reload();
});

// ========== Socket Events ==========
socket.on('roomCreated', ({ roomId, playerId }) => {
  currentRoomId = roomId;
  myPlayerId = playerId;
  isHost = true;
  document.getElementById('roomCodeText').textContent = roomId;
  showScreen('lobbyScreen');
});

socket.on('roomJoined', ({ roomId, playerId }) => {
  currentRoomId = roomId;
  myPlayerId = playerId;
  isHost = false;
  document.getElementById('roomCodeText').textContent = roomId;
  showScreen('lobbyScreen');
});

socket.on('lobbyUpdate', ({ players }) => {
  const list = document.getElementById('playersList');
  list.innerHTML = players.map(p => `
    <div class="player-item">
      <span>${p.id === myPlayerId ? '👉 ' : ''}${p.name}</span>
      ${p.isHost ? '<span class="host-badge">هۆست</span>' : ''}
    </div>
  `).join('');

  const me = players.find(p => p.id === myPlayerId);
  isHost = me && me.isHost;
  
  if (isHost && players.length >= 2) {
    document.getElementById('startGameBtn').style.display = 'block';
    document.getElementById('waitingMsg').textContent = `${players.length} یاریزان ئامادەن - دەتوانی دەستپێبکەی!`;
  } else if (isHost) {
    document.getElementById('startGameBtn').style.display = 'none';
    document.getElementById('waitingMsg').textContent = 'چاوەڕێی یاریزانی زیاتر... (لانیکەم ٢)';
  } else {
    document.getElementById('startGameBtn').style.display = 'none';
    document.getElementById('waitingMsg').textContent = 'چاوەڕێی هۆست دەکەی بۆ دەستپێکردن...';
  }
});

socket.on('gameState', (state) => {
  gameData = state;
  selectedTile = null;
  document.getElementById('winnerModal').classList.remove('active');

  if (state.started || state.winner) {
    showScreen('gameScreen');
    renderGame(state);
  }

  if (state.winner) {
    setTimeout(() => showWinner(state.winner), 500);
  }
});

socket.on('error', ({ message }) => {
  showMessage(message, true);
});

// ========== Render Game ==========
function renderGame(state) {
  // Players bar
  const bar = document.getElementById('playersBar');
  bar.innerHTML = state.players.map((p, i) => `
    <div class="player-card ${i === state.currentTurn ? 'current' : ''} ${!p.connected ? 'disconnected' : ''}">
      <div class="name">${p.id === myPlayerId ? '👉 ' : ''}${p.name}${!p.connected ? ' 🔌' : ''}</div>
      <div class="info">🎴 ${p.tilesCount} دۆمینۆ</div>
    </div>
  `).join('');

  // Board
  const board = document.getElementById('board');
  if (state.board.length === 0) {
    board.classList.add('empty');
    board.innerHTML = '';
  } else {
    board.classList.remove('empty');
    board.innerHTML = state.board.map(tile => `
      <div class="domino ${tile.left === tile.right ? 'vertical' : 'horizontal'}">
        <div class="domino-half">${createPips(tile.left)}</div>
        <div class="domino-half">${createPips(tile.right)}</div>
      </div>
    `).join('');
  }

  // Boneyard
  document.getElementById('boneyardInfo').textContent = `🎴 ${state.boneyardCount} دۆمینۆ لە بۆنی‌یاردا`;

  // Message
  if (state.yourTurn) {
    showMessage('👉 نۆرەی تۆیە! دۆمینۆیەک هەڵبژێرە');
  } else {
    showMessage(`⏳ نۆرەی ${state.currentPlayerName}ـە...`);
  }

  // Hand
  const hand = document.getElementById('hand');
  hand.innerHTML = state.yourHand.map(tile => {
    const can = canPlayTile(tile, state.board);
    const playable = (can.left || can.right) && state.yourTurn;
    return `
      <div class="hand-tile ${playable ? 'playable' : ''} ${!state.yourTurn ? 'disabled' : ''}" data-id="${tile.id}">
        <div class="domino-half">${createPips(tile.left)}</div>
        <div class="domino-half">${createPips(tile.right)}</div>
      </div>
    `;
  }).join('');

  hand.querySelectorAll('.hand-tile').forEach(el => {
    el.addEventListener('click', () => {
      if (!state.yourTurn) return;
      const id = el.dataset.id;
      const tile = state.yourHand.find(t => t.id === id);
      if (selectedTile && selectedTile.id === id) {
        selectedTile = null;
        el.classList.remove('selected');
      } else {
        document.querySelectorAll('.hand-tile.selected').forEach(e => e.classList.remove('selected'));
        selectedTile = tile;
        el.classList.add('selected');
      }
      updateButtons();
    });
  });

  updateButtons();
}

function updateButtons() {
  const leftBtn = document.getElementById('playLeftBtn');
  const rightBtn = document.getElementById('playRightBtn');
  const drawBtn = document.getElementById('drawBtn');
  const passBtn = document.getElementById('passBtn');

  if (!gameData || !gameData.yourTurn) {
    leftBtn.disabled = true;
    rightBtn.disabled = true;
    drawBtn.disabled = true;
    passBtn.disabled = true;
    return;
  }

  drawBtn.disabled = gameData.boneyardCount === 0;
  passBtn.disabled = false;

  if (selectedTile) {
    const can = canPlayTile(selectedTile, gameData.board);
    if (gameData.board.length === 0) {
      leftBtn.disabled = true;
      rightBtn.disabled = false;
      rightBtn.textContent = '🎯 دانان';
    } else {
      leftBtn.disabled = !can.left;
      rightBtn.disabled = !can.right;
      rightBtn.textContent = 'ڕاست ▶';
    }
  } else {
    leftBtn.disabled = true;
    rightBtn.disabled = true;
    rightBtn.textContent = 'ڕاست ▶';
  }
}

function showWinner(winner) {
  let text = `${winner.name} براوە بوو! 🎉`;
  if (winner.reason === 'block') {
    text = `یاریەکە بەستراوە! ${winner.name} بە کەمترین خاڵ (${winner.pips}) براوە بوو! 🎉`;
  }
  document.getElementById('winnerText').textContent = text;
  document.getElementById('restartBtn').style.display = isHost ? 'block' : 'none';
  document.getElementById('winnerModal').classList.add('active');
}
</script>

